language: de_DE
-
zoom in: edit.zoom_in()
zoom out: edit.zoom_out()
scroll up: edit.page_up()
scroll down: edit.page_down()
(copy [that] | kopieren [bitte]): key(ctrl-c)
ausschneiden bitte: key(ctrl-x)
einfügen bitte: key(ctrl-v)
rückgängig bitte: edit.undo()
wiederholen bitte: edit.redo()
paste match: edit.paste_match_style()
speichern bitte: edit.save()
kill: key(backspace)
(clear | löschen bitte): key(delete)
enter: key(enter)


