title:ARK: Survival Evolved
mode: sleep
-
tag(): user.gaming
tag(): user.gaming_ark

settings():
    key_hold = 32.0
    key_wait = 20.02
    speech.timeout = 0.150
#    speech.engine = 'wav2letter'

other window: key("alt-tab")

mick: mouse_click(2)

duck: key("c:down")
run: key("shift:down")
stand:
  key("c:up")
  key("shift:up")


sit: key("i")



one: key("1")
two: key("2")
three: key("3")
(for | four): key("4")
five: key("5")
six: key("6")
seven: key("7")
eight: key("8")
nine: key("9")
zero: key("0")


toggle touch: user.toggle_mouse_button(0)
toggle rick: user.toggle_mouse_button(1)
toggle mike: user.toggle_mouse_button(2)

