language: de_DE
app: obsidian
app: slack
-

Leertaste: " "
Gänsefüßchen: insert('"')
Bindestrich: insert('-')
Unterstrich: insert('_')
Schrägstrich: insert("/")
Backslash: insert("\\")
Apostroph: insert("'")
Klammer: insert("(")
Asterisk: insert("*")
at: insert("@")
Innen: "Innen"

Absatz: key("enter:2")
Umbruch: key("shift-enter")
enter: key("enter")
tab: key("tab")


<phrase>: insert(user.formatted_text("{phrase}", 'DRAGON_TEXT'))
öffne Diktierfenster: key(ctrl-shift-d)

